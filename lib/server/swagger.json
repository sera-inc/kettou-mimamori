            "description": "記録の検索条件。ネストした検索構文に対応します。例：`find[created_at][$gte]=2015-08-27`。すべてのfindパラメータを文字列として解釈します。",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "tags": [
          "Devicestatus"
        ],
        "responses": {
          "200": {
            "description": "削除処理の状態を示す記録。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteStatus"
                }
              }
            }
          },
          "default": {
            "description": "予期しないエラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/devicestatus/{spec}": {
      "delete": {
        "summary": "指定したIDの端末状態の記録を削除",
        "description": "端末状態の記録に関する情報を返します。",
        "parameters": [
          {
            "name": "spec",
            "in": "path",
            "description": "記録のID。例：`55cf81bc436037528ec75fa5`。",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "tags": [
          "Devicestatus"
        ],
        "responses": {
