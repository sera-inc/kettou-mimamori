{
  "openapi": "3.0.0",
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "info": {
    "title": "血糖みまもり API",
    "description": "血糖の測定値と日々の記録を取得・保存するAPIです。",
    "version": "14.2.3",
    "license": {
      "name": "AGPL 3",
      "url": "https://www.gnu.org/licenses/agpl.txt"
    },
    "contact": {
      "name": "株式会社世良",
      "url": "https://sera-inc.co.jp",
      "email": "info@sera-inc.co.jp"
    }
  },
  "security": [
    {
      "api_secret": [],
      "token_in_url": [],
      "jwtoken": []
    }
  ],
  "paths": {
    "/entries/{spec}": {
      "get": {
        "summary": "検索条件に一致する測定記録を取得",
        "description": "測定記録の情報を返します。",
        "parameters": [
          {
            "name": "spec",
            "in": "path",
            "description": "測定記録のID（例：`55cf81bc436037528ec75fa5`）または種類による絞り込み（例：`sgv`、`mbg`など）。",
            "required": true,
            "schema": {
              "type": "string",
              "default": "sgv"
            }
          },
          {
            "name": "find",
            "in": "query",
            "description": "測定記録の検索条件。ネストした検索構文に対応します。例：`find[dateString][$gte]=2015-08-27`。すべてのfindパラメータを文字列として解釈します。",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "count",
            "in": "query",
            "description": "返す測定記録の件数。",
            "required": false,
            "schema": {
              "type": "number"
            }
          }
        ],
        "tags": [
          "Entries"
        ],
        "responses": {
          "200": {
            "description": "測定記録の配列",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entries"
                }
              }
            }
          },
          "default": {
            "description": "測定記録",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entries"
                }
              }
            }
          }
        }
      }
    },
    "/slice/{storage}/{field}/{type}/{prefix}/{regex}": {
      "get": {
        "summary": "検索条件に一致する測定記録を取得",
        "description": "測定記録の情報を返します。",
        "parameters": [
          {
            "name": "storage",
            "in": "path",
            "description": "先頭一致の正規表現を組み立てるための接頭辞。既定値は`entries`。",
            "required": true,
            "schema": {
              "type": "string",
              "default": "entries"
            }
          },
          {
            "name": "field",
            "in": "path",
            "description": "検索条件で正規表現を適用するフィールド名。既定値は`dateString`。",
            "required": true,
            "schema": {
              "type": "string",
              "default": "dateString"
            }
          },
          {
            "name": "type",
            "in": "path",
            "description": "検索する種類。既定値はsgv。",
            "required": true,
            "schema": {
              "type": "string",
              "default": "sgv"
            }
          },
          {
            "name": "prefix",
            "in": "path",
            "description": "先頭一致の正規表現を組み立てるための接頭辞。",
            "required": true,
            "schema": {
              "type": "string",
              "default": "2015"
            }
          },
          {
            "name": "regex",
            "in": "path",
            "description": "検索条件を展開・構築するときに使用する正規表現の末尾部分。bash形式の波括弧展開とグロブ展開にも対応し、時間帯を検索できます。例：`T{15..17}:.*`で15時から17時の記録を検索します。",
            "required": true,
            "schema": {
              "type": "string",
              "default": ".*"
            }
          },
          {
            "name": "find",
            "in": "query",
            "description": "測定記録の検索条件。ネストした検索構文に対応します。例：`find[dateString][$gte]=2015-08-27`。すべてのfindパラメータを文字列として解釈します。",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "count",
            "in": "query",
            "description": "返す測定記録の件数。",
            "required": false,
            "schema": {
              "type": "number"
            }
          }
        ],
        "tags": [
          "Entries"
        ],
        "responses": {
          "200": {
            "description": "測定記録の配列",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entries"
                }
              }
            }
          },
          "default": {
            "description": "予期しないエラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/echo/{storage}/{spec}": {
      "get": {
        "summary": "生成したMongoDB検索条件を表示",
        "description": "検索処理で生成したMongoDB検索条件の情報。",
        "parameters": [
          {
            "name": "storage",
            "in": "path",
            "description": "保存先を`entries`または`treatments`から選択します。",
            "required": true,
            "schema": {
              "type": "string",
              "default": "sgv"
            }
          },
          {
            "name": "spec",
            "in": "path",
            "description": "測定記録のID（例：`55cf81bc436037528ec75fa5`）または種類による絞り込み（例：`sgv`、`mbg`など）。このパラメータは省略可能です。",
            "required": true,
            "schema": {
              "type": "string",
              "default": "sgv"
            }
          },
          {
            "name": "find",
            "in": "query",
            "description": "測定記録の検索条件。ネストした検索構文に対応します。例：`find[dateString][$gte]=2015-08-27`。すべてのfindパラメータを文字列として解釈します。",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "count",
            "in": "query",
            "description": "返す測定記録の件数。",
            "required": false,
            "schema": {
              "type": "number"
            }
          }
        ],
        "tags": [
          "Entries",
          "Debug"
        ],
        "responses": {
          "200": {
            "description": "測定記録の配列",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MongoQuery"
                }
              }
            }
          }
        }
      }
    },
