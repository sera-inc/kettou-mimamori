# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim
WORKDIR /opt/app
COPY package.json package-lock.json ./
RUN --mount=type=secret,id=local_ca,required=true \
    NODE_EXTRA_CA_CERTS=/run/secrets/local_ca npm ci --ignore-scripts --omit=optional --force --no-audit --no-fund
COPY . .
RUN npm run bundle
CMD ["node", "lib/server/server.js"]
