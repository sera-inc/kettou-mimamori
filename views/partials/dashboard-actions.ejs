<div id="buttonbar" class="app-dashboard-actions" role="group" aria-label="表示と記録の操作">
  <button type="button" id="boluscalcDrawerToggle" class="tip app-button" data-type="outline" original-title="インスリンの計算" aria-label="インスリンの計算を開く" style="display:none"><i class="icon-calc" aria-hidden="true"></i><span>インスリンの計算</span></button>
  <button type="button" id="treatmentDrawerToggle" class="tip app-button" data-type="outline" original-title="記録を追加" aria-label="記録を追加する画面を開く" style="display:none"><i class="icon-plus" aria-hidden="true"></i><span>記録を追加</span></button>
  <button type="button" id="lockedToggle" class="tip app-button" data-type="outline" original-title="記録には認証が必要です" aria-label="記録するために認証する" style="display:none"><i class="icon-lock" aria-hidden="true"></i><span>認証する</span></button>
  <button type="button" id="drawerToggle" class="tip app-button" data-type="outline" original-title="表示の設定" aria-label="表示の設定を開く"><i class="icon-menu" aria-hidden="true"></i><span>表示の設定</span></button>
  <button type="button" id="testAlarms" class="tip app-button" data-type="outline" original-title="通知音の確認・スマートフォンでの有効化" aria-label="通知音を確認する"><i class="icon-volume" aria-hidden="true"></i><span>通知音を確認</span></button>
  <button type="button" id="editbutton" class="tip app-button" data-type="outline" original-title="記録の編集" aria-label="記録の編集モードを切り替える" style="display:none"><i class="icon-edit" aria-hidden="true"></i><span>記録を編集</span></button>
  <button type="button" id="adminnotifies" class="tip app-button" data-type="outline" original-title="管理者からのお知らせ" aria-label="管理者からのお知らせを開く" style="display:none"><i class="plugicon-notifies" aria-hidden="true"></i><span>お知らせ</span></button>
</div>
