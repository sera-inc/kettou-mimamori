<a class="app-skip-link" href="#app-main">本文へ移動</a>
<header id="toolbar" class="app-header">
    <button id="app-nav-toggle" type="button" aria-controls="app-nav" aria-expanded="false">メニュー</button>
    <a class="app-brand" href="/"><img class="app-brand-mark" src="/brand/mark.svg" width="32" height="32" alt="" aria-hidden="true"><strong class="app-service-name">血糖みまもり</strong></a>

    <%if (type !== 'index') { %>
        <a href="/" class="closeButton button-close" aria-label="血糖の状態へ戻る"><span>一覧へ戻る</span></a>
    <% } %>

</header>
<div id="app-nav-backdrop" hidden aria-hidden="true"></div>
<div id="app-nav" class="app-nav" data-open="false"><nav aria-label="サービスのメニュー">
  <button id="app-nav-close" type="button">メニューを閉じる</button>
  <p class="app-nav-section">記録と表示</p>
  <% const items=[['index','/','血糖の状態'],['report','/report','レポート'],['profile','/profile','プロフィール'],['food','/food','食品と食事'],['admin','/admin','管理ツール']]; %>
  <% items.forEach(function(item){ %>
    <a class="app-nav-item" href="<%= item[1] %>" <% if(type===item[0]) { %>aria-current="page"<% } %>><span><%= item[2] %></span></a>
  <% }); %>
  <p class="app-nav-section">表示を切り替える</p>
  <a class="app-nav-item" href="/clock/clock">時計表示</a>
  <a class="app-nav-item" href="/clock/config" <% if(type==='clockconfig') { %>aria-current="page"<% } %>>時計の設定</a>
  <a class="app-nav-item" href="/split" <% if(type==='split') { %>aria-current="page"<% } %>>複数の画面を表示</a>
</nav><div class="app-service-support" role="contentinfo" aria-label="会社とお問い合わせ">
  <p>運営：株式会社世良</p>
  <a href="mailto:info@sera-inc.co.jp">お問い合わせ</a>
  <a href="https://sera-inc.co.jp" target="_blank" rel="noopener noreferrer">会社情報</a>
</div></div>
